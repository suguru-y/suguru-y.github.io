@article{Murayama2026,
  bibtex_show={true},
  title={Lattice softening and diffusive dynamics in the polar metal LiReO<sub>3</sub>}, 
    author    = "Murayama, Kantaro and Masuki, Ryota and Tassel, C\'{e}dric and
               Sakai, Hideaki and Yanagisawa, Tatsuya and Yoshida, Keito and
               Oike, Hiroshi and Yoshida, Suguru and Gu, Xiangyu and Ishida,
               Kohdai and Namba, Morito and Denisova, Ksenia and Dupray,
               Val\'{e}rie and Clevers, Simon and Mentr\'{e}, Olivier and
               Nomoto, Takuya and Tadano, Terumasa and Brown, Craig M and
               Lemmens, Peter and Arita, Ryotaro and Takatsu, Hiroshi and
               Kageyama, Hiroshi",
  preview={Murayama2026SciAdv.png},
  year={2026},
  abstract = "Polar metals, where metallicity coexists with polar order, represent a frontier in quantum materials.
              Here, we uncover anomalous diffusive dynamics in LiReO<sub>3</sub> across its polar-to-nonpolar transition.
              Unlike related systems, LiReO<sub>3</sub> exhibits pronounced phase fluctuations both above and below Ts, evidenced by probe-dependent hysteresis and persistent lattice dynamics over microsecond timescales.
              These results reveal multiscale fluctuations arising from a shallow anharmonic potential stabilized by itinerant electrons, offering a new perspective on fluctuation-driven phenomena in polar metals.",
  abbr={Sci. Adv.},
  journal={Sci. Adv.},
  volume={12},
  number={14},
  pages={eadt3886},
  year={2026},
  doi={10.1126/sciadv.adt3886},
}

@article{Yoshida2026,
  annotation={S.Y. is the corresponding author.},
  bibtex_show={true},
  selected={true},
  title={Switchable Polarization in an A-Site Deficient Perovskite through Vacancy and Cation Engineering}, 
  author={Suguru Yoshida and Olivier Hernandez and Jinsuke Miyake and Kei Nakayama and Ryo Ishikawa and Hajime Hojo and Yuichi Ikuhara and Venkatraman Gopalan and Katsuhisa Tanaka and Koji Fujita},
  preview={Yoshida2026JACS.png},
  year={2026},
  arxiv={2511.01241},
  abstract = "Defects are often considered detrimental to crystalline materials, yet they can also be a powerful source of functionality when properly used.
               We demonstrate that the A-site-deficient perovskite Y<sub>1/3</sub>TaO<sub>3</sub> exhibits a switchable polarization enabled by ordered vacancies coupled with TaO<sub>6</sub> octahedral rotations.
               By favoring rotational over off-centering instabilities, this system avoids centrosymmetric incommensurate states common to defect-ordered perovskites.
               Unlike canonical improper ferroelectrics, vanishing dipoles on vacancy layers allow a net ferroelectric alignment, enhancing polarization.
               Superspace analysis and lattice-dynamics calculations further reveal that epitaxial strain offers a route to amplify polarization.
               This defect-ordering strategy provides a general pathway to boost polarization in improper ferroelectrics.",
  abbr={JACS},
  journal={J. Am. Chem. Soc.},
  volume={148},
  number={4},
  pages={4557--4567},
  year={2026},
  arxiv={2511.01241},
  doi={10.1021/jacs.5c19790},
}

